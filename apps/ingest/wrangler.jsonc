{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hw-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Edge feeds (Air4Thai, USGS, TMD) every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "kv_namespaces": [
    // Created with `wrangler kv namespace create SNAPSHOTS`.
    { "binding": "SNAPSHOTS", "id": "377230799e294be5a12ecc9ca7a9b0f3" }
  ],
  "d1_databases": [
    // Push subscriptions. Schema: migrations/ (apply with `wrangler d1 migrations apply hw-push --remote`).
    { "binding": "PUSH_DB", "database_name": "hw-push", "database_id": "36625d1e-d797-48c1-af87-c4e847bf1c3a" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://hw-web.pdouvch.workers.dev,http://localhost:3000",
    // Web Push (VAPID). The private key is a secret: `wrangler secret put VAPID_PRIVATE_KEY`.
    "VAPID_PUBLIC_KEY": "BGx4EhUOVhaclyTgFL44N865zJfC1EOgnfJyErvG5q7WXOkhFiTB9QRCIkc3AQmfO_9apt7ON0xi4Q4KxhdJLjQ",
    "VAPID_SUBJECT": "https://hw-web.pdouvch.workers.dev",
    // Where a tapped notification opens.
    "SITE_URL": "https://hw-web.pdouvch.workers.dev"
  }
  // Secrets: INGEST_TOKEN (shared with the GitHub Actions runner), VAPID_PRIVATE_KEY.
}
