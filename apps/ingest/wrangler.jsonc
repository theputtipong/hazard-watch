{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hw-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Edge feeds (Air4Thai, USGS, TMD) every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "kv_namespaces": [
    // Created with `wrangler kv namespace create SNAPSHOTS`; replace the id before the first deploy.
    { "binding": "SNAPSHOTS", "id": "REPLACE_WITH_KV_ID" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000"
  }
  // Secret (set with `wrangler secret put INGEST_TOKEN`): shared with the GitHub Actions runner.
}
