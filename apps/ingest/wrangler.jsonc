{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hw-ingest",
  "main": "src/index.ts",
  "routes": [{ "pattern": "api.hazard.pdouvch.com", "custom_domain": true }],
  // Older builds and links still use the workers.dev address.
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "kv_namespaces": [
    { "binding": "SNAPSHOTS", "id": "377230799e294be5a12ecc9ca7a9b0f3" }
  ],
  "d1_databases": [
    { "binding": "PUSH_DB", "database_name": "hw-push", "database_id": "36625d1e-d797-48c1-af87-c4e847bf1c3a" }
  ],
  // Misses on /v1/weather per IP; protects the Open-Meteo free quota (10,000 calls/day).
  "ratelimits": [
    { "name": "WEATHER_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://hazard.pdouvch.com,https://pdouvch.com,https://hw-web.pdouvch.workers.dev,http://localhost:3000",
    // Private key is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BGx4EhUOVhaclyTgFL44N865zJfC1EOgnfJyErvG5q7WXOkhFiTB9QRCIkc3AQmfO_9apt7ON0xi4Q4KxhdJLjQ",
    "VAPID_SUBJECT": "https://hazard.pdouvch.com",
    "SITE_URL": "https://hazard.pdouvch.com",
    // The cron dispatches this repo's ingest-runner workflow only when GITHUB_DISPATCH_TOKEN is set.
    "GITHUB_REPO": "theputtipong/hazard-watch"
  }
  // Secrets: INGEST_TOKEN (shared with the GitHub Actions runner), VAPID_PRIVATE_KEY, optional GITHUB_DISPATCH_TOKEN.
}
