{
  "name": "@hw/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE:-https://api.hazard.pdouvch.com} opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hw/core": "workspace:*",
    "@hw/tokens": "workspace:*",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@opennextjs/cloudflare": "^1.20.8",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
