{
  "$comment": "Single source of the HazardWatch design system. Edit here, then run `pnpm --filter @hw/tokens generate`. sev-* colours mean risk only: never decoration, buttons or system status.",
  "font": {
    "family": "IBM Plex Sans Thai",
    "webVariable": "--font-plex-thai",
    "fallback": ["Noto Sans Thai", "system-ui", "sans-serif"]
  },
  "color": {
    "$comment": "Each mode overrides the one before it, in the same order as the CSS cascade: light <- dark <- cvd <- darkCvd.",
    "light": {
      "bg": "#f6f7f9",
      "surface": "#ffffff",
      "surface-sunken": "#eef0f3",
      "line": "#e2e5ea",
      "line-control": "#8a93a3",
      "ink": "#0f1b2e",
      "ink-muted": "#566072",
      "on-ink": "#ffffff",
      "brand": "#0f1b2e",
      "accent": "#2457d6",
      "on-accent": "#ffffff",
      "water": "#3d7bff",
      "sev-normal": "#8a93a3",
      "sev-watch": "#b07f00",
      "sev-watch-ink": "#7a5500",
      "sev-watch-soft": "#fdf3d3",
      "sev-warning": "#e0640a",
      "sev-warning-ink": "#9c4006",
      "sev-warning-soft": "#fde8d6",
      "sev-danger": "#c81e1e",
      "sev-danger-ink": "#a3171b",
      "sev-danger-soft": "#fbe1e1",
      "on-sev": "#0f1b2e",
      "on-sev-danger": "#ffffff"
    },
    "dark": {
      "bg": "#0a111e",
      "surface": "#111b2c",
      "surface-sunken": "#1a263a",
      "line": "#1f2b40",
      "line-control": "#5d6b84",
      "ink": "#e6ebf3",
      "ink-muted": "#94a1b8",
      "on-ink": "#0a111e",
      "brand": "#1e3254",
      "accent": "#8dbbff",
      "on-accent": "#0a111e",
      "sev-normal": "#5d6b84",
      "sev-watch": "#f5c542",
      "sev-watch-ink": "#f5c542",
      "sev-watch-soft": "#2e2610",
      "sev-warning": "#ff9440",
      "sev-warning-ink": "#ff9440",
      "sev-warning-soft": "#35200f",
      "sev-danger": "#ff6464",
      "sev-danger-ink": "#ff7a7a",
      "sev-danger-soft": "#3a1519",
      "on-sev": "#0a111e",
      "on-sev-danger": "#0a111e"
    },
    "cvd": {
      "sev-watch": "#ddcc77",
      "sev-watch-ink": "#5c4f10",
      "sev-watch-soft": "#f6f0d6",
      "sev-warning": "#cc6677",
      "sev-warning-ink": "#7a2f3f",
      "sev-warning-soft": "#f5dde2",
      "sev-danger": "#882255",
      "sev-danger-ink": "#5a0f33",
      "sev-danger-soft": "#ecd3df",
      "on-sev-danger": "#ffffff"
    },
    "darkCvd": {
      "sev-watch-ink": "#eadf9e",
      "sev-watch-soft": "#3a3519",
      "sev-warning-ink": "#f0a9b6",
      "sev-warning-soft": "#42232b",
      "sev-danger": "#e59ac0",
      "sev-danger-ink": "#e59ac0",
      "sev-danger-soft": "#3a1427",
      "on-sev-danger": "#0a111e"
    }
  },
  "text": {
    "$comment": "Thai needs line-height of at least 1.5x so vowels and tone marks never clip. letterSpacing is in em.",
    "caption": { "size": 12, "lineHeight": 18 },
    "label": { "size": 13, "lineHeight": 20, "weight": 500 },
    "body": { "size": 15, "lineHeight": 24 },
    "title": { "size": 17, "lineHeight": 26, "weight": 600 },
    "heading": { "size": 22, "lineHeight": 32, "weight": 600 },
    "figure-sm": { "size": 24, "lineHeight": 28, "letterSpacing": -0.01 },
    "figure": { "size": 36, "lineHeight": 40, "letterSpacing": -0.02 }
  },
  "radius": { "tiny": 4, "small": 6, "control": 8, "card": 12 },
  "shadow": {
    "light": {
      "raised": { "y": 1, "blur": 2, "color": "#0f1b2e", "opacity": 0.06 },
      "overlay": { "y": 8, "blur": 24, "color": "#0f1b2e", "opacity": 0.14 }
    },
    "dark": {
      "raised": null,
      "overlay": { "y": 8, "blur": 24, "color": "#000000", "opacity": 0.55 }
    }
  },
  "meter": {
    "$comment": "Level = number of filled bars, so severity reads without colour.",
    "inactiveOpacity": 0.28,
    "sm": { "gap": 2, "barWidth": 3, "barHeights": [6, 9, 12] },
    "lg": { "gap": 3, "barWidth": 5, "barHeights": [10, 15, 20] }
  },
  "motion": {
    "$comment": "The only motion in the design system: fresh data fades in.",
    "fadeInMs": 150
  }
}
